# Copia este archivo a .env y completa con los datos de tu proyecto Supabase.
# Solo va la publishable key (nunca la secret key).
# La clave de Anthropic NO va aquí: es un secreto de la Edge Function (ver README).
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
